# OmniHearth Environment Variables Template
# Copy this file to .env and configure the credentials. Do not commit .env to source control.

# Google Cloud Project settings for Vertex AI model orchestration
# (Ensure your environment has Application Default Credentials via `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here
GOOGLE_CLOUD_REGION=us-central1

# Firebase Admin SDK Configuration (for Unified Memory Graph)
# For local emulator testing, set USE_FIREBASE_EMULATOR=true
USE_FIREBASE_EMULATOR=true
FIREBASE_PROJECT_ID=omnihearth-dev
FIREBASE_DATABASE_URL=https://omnihearth-dev.firebaseio.com

# Firebase Service Account Credentials (if not using emulator)
# Paste the service account JSON contents here or point to the JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/service-account.json

# Backend Configuration
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info
